# YOUTUBE_CONTENT_FACTORY - environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (Anthropic Claude) - research / script / scene prompts / scoring ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Set to false to disable the web_search tool in researcher.py (not recommended -
# research quality/groundedness drops a lot without it).
CLAUDE_WEB_SEARCH_ENABLED=true
CLAUDE_MAX_RETRIES=3
# Per-request timeout (seconds) for Claude API calls. Raise this if long
# classification calls (e.g. Scene Planner V2, max_tokens up to 14000) are
# hitting read timeouts before the model finishes generating.
CLAUDE_TIMEOUT_SECONDS=240

# --- Image generation (fal.ai) ---
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_MAX_RETRIES=3

# --- TTS narration (OpenAI) ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Standard production voice ("Deep Documentary" A/B test result - replaces
# the earlier "onyx" default). Per-language voice override, e.g.
# TTS_VOICE_TR=echo - falls back to OPENAI_TTS_VOICE above when unset. Add
# one line per new localization language; no code change needed (see
# core/config.py's tts_voice_for()).
OPENAI_TTS_VOICE=echo
# TTS_VOICE_EN=echo
# TTS_VOICE_TR=echo
# Style/delivery guidance sent as the OpenAI TTS "instructions" field
# (gpt-4o-mini-tts and newer only - ignored/omitted for tts-1/tts-1-hd,
# which reject it). Leave commented to use the built-in "Deep Documentary"
# default in core/config.py (calm, authoritative, deliberately paced,
# restrained, cinematic). Per-language override: TTS_INSTRUCTIONS_TR=...
# (see core/config.py's tts_instructions_for()) - falls back to
# OPENAI_TTS_INSTRUCTIONS below when unset, exactly like the voice above.
# OPENAI_TTS_INSTRUCTIONS=Deep, warm, mature documentary narration. Calm and authoritative. Slow, deliberate pacing with natural pauses. Clear articulation, restrained emotion, cinematic atmosphere. The voice should feel intelligent, mysterious and trustworthy, never exaggerated or theatrical.
# TTS_INSTRUCTIONS_TR=

# --- Multilingual production (Round 3) ---
# ONE research + ONE master script + ONE shared scene plan + ONE shared
# set of AI visuals is always produced once, in LANGUAGE_MASTER; each
# language in LANGUAGE_LOCALIZATIONS gets its own natural-language
# localization + narration + metadata, reusing the same visuals. Add a
# future language (es, de, fr, it, pt, id, ...) by adding its code here -
# see youtube/localizer.py for which languages have a prompt name mapped.
LANGUAGE_MASTER=en
LANGUAGE_LOCALIZATIONS=tr

# --- Telegram approval bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube Data API upload (legacy/default single channel) ---
# Create an OAuth 2.0 Client ID (Desktop app) in Google Cloud Console with the
# YouTube Data API v3 enabled, then run `python -m youtube.uploader --authorize`
# once to get YOUTUBE_REFRESH_TOKEN. The consent screen must request BOTH scopes
# in youtube/uploader.py's SCOPES (youtube.upload + youtube.readonly) - a token
# obtained before this was added only has "upload" and will fail with a 403
# "insufficient authentication scopes" on `--check-channel` until you re-run
# --authorize. This is the ONLY channel used when YOUTUBE_CHANNELS below is
# left empty - existing single-channel setups need no changes.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_UPLOAD_PRIVACY=private
YOUTUBE_CATEGORY_ID=27

# --- YouTube multi-channel routing (Round 3.2) ---
# Optional. The content pipeline above is ALWAYS shared/produced once - this
# only controls which YouTube channel(s) a finished video can be uploaded to.
# Leave YOUTUBE_CHANNELS empty (the default) to keep using the single legacy
# channel above; nothing below is required for that.
#
# To route to multiple channels instead, list stable internal channel keys
# here, then define YOUTUBE_CHANNEL_<KEY>_* for each one (KEY uppercased).
# Only CLIENT_ID/CLIENT_SECRET/REFRESH_TOKEN are required per channel; the
# rest are optional and fall back to the global defaults above when unset.
# Authorize each channel separately (this opens a browser consent flow
# against THAT channel's Google account - never reuse one token across
# channels): `python -m youtube.uploader --authorize --channel english`.
# Verify without uploading anything: `python -m youtube.uploader --check-channel --channel english`.
#
# YOUTUBE_CHANNELS=english,turkish
#
# YOUTUBE_CHANNEL_ENGLISH_CLIENT_ID=
# YOUTUBE_CHANNEL_ENGLISH_CLIENT_SECRET=
# YOUTUBE_CHANNEL_ENGLISH_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_ENGLISH_DISPLAY_NAME=AI Found This
# YOUTUBE_CHANNEL_ENGLISH_ENABLED=true
# YOUTUBE_CHANNEL_ENGLISH_LANGUAGE=en
# YOUTUBE_CHANNEL_ENGLISH_PRIVACY=private
# YOUTUBE_CHANNEL_ENGLISH_CATEGORY_ID=27
# Optional but recommended safety check: the channel_id (NOT the display
# name) `--check-channel` should see when authenticated as this channel -
# get it once via `--check-channel --channel english`, then pin it here so
# a future re-authorization against the wrong Google account fails loudly
# instead of silently uploading to the wrong channel.
# YOUTUBE_CHANNEL_ENGLISH_EXPECTED_CHANNEL_ID=
#
# YOUTUBE_CHANNEL_TURKISH_CLIENT_ID=
# YOUTUBE_CHANNEL_TURKISH_CLIENT_SECRET=
# YOUTUBE_CHANNEL_TURKISH_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_TURKISH_DISPLAY_NAME=AI Found This TR
# YOUTUBE_CHANNEL_TURKISH_LANGUAGE=tr
# YOUTUBE_CHANNEL_TURKISH_EXPECTED_CHANNEL_ID=

# --- Optional ---
# If your finished videos (storage/<slug>/video.mp4) are also served publicly by
# something you run (nginx, Caddy, a static host pointed at storage/, etc.), set this
# to that base URL. telegram_bot.py then links to it as a preview fallback whenever a
# video is too large for Telegram's own ~50MB inline upload limit. Leave blank if you
# don't serve storage/ publicly - the bot will say so instead of guessing a broken link
# (it never sends a local filesystem path).
PUBLIC_BASE_URL=
DEFAULT_PROJECT_ID=mystery_youtube

# --- Local/offline testing (no API keys/cost) ---
# IMAGE_PROVIDER=mock uses Pillow-rendered placeholder scene images instead of fal.ai.
# TTS_PROVIDER=mock uses a pure-Python generated placeholder tone instead of OpenAI TTS
# (no external binary required either way).
IMAGE_PROVIDER=fal
TTS_PROVIDER=openai

# --- Advanced tuning (sensible defaults - only change if you know why) ---
# Scene planning: an 8-10min script (~1200-1600 words) targets this many scenes.
# See youtube/scene_planner.py for how these interact.
SCENE_MIN_COUNT=25
SCENE_MAX_COUNT=40
SCENE_WORDS_PER_SCENE_TARGET=45
SCENE_WORDS_PER_SECOND=2.5
# Output video/thumbnail dimensions.
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
# Where things are stored on disk - relative to the project root by default.
# STORAGE_DIR=./storage
# LOG_DIR=./logs
# DB_PATH=./storage/factory.db
# MEDIA_MUSIC_DIR=./storage/music

# --- Smart Publish Scheduler V1 (AI FOUND THIS) ---
# Opt-in: when SMART_PUBLISH_ENABLED=false, APPROVE behaves exactly as
# before this feature existed (immediate private upload -> thumbnail ->
# Telegram update). When true, APPROVE instead computes an optimal publish
# time (deterministic bootstrap fallback in V1 - see youtube/smart_publish.py)
# and uploads with that time as YouTube's own publishAt/privacyStatus=private
# scheduling, never publishing public immediately.
SMART_PUBLISH_ENABLED=true
SMART_PUBLISH_TIMEZONE=Europe/Istanbul
SMART_PUBLISH_DEFAULT_HOUR=20
SMART_PUBLISH_DEFAULT_MINUTE=00
SMART_PUBLISH_MIN_DELAY_MINUTES=60
SMART_PUBLISH_LOOKAHEAD_DAYS=7
SMART_PUBLISH_MODE=auto
SMART_PUBLISH_REQUIRE_APPROVAL=true
SMART_PUBLISH_ALLOW_IMMEDIATE=false

# --- YouTube Analytics Timing V1 (AI FOUND THIS) ---
# Purely additive on top of Smart Publish V1 above. Opt-in: when
# YOUTUBE_ANALYTICS_ENABLED=false (the library default), zero YouTube
# Analytics API calls are made and Smart Publish behaves exactly as before
# this feature existed (bootstrap default only). When true, Smart Publish
# also consults real per-video performance data (day-level metrics bucketed
# by weekday/hour of each video's publish time - see
# youtube/analytics_timing.py's module docstring for why this is
# "inferred_performance" rather than a "direct" audience-online-by-hour
# reading: the public YouTube Analytics API v2 has no hour-of-day
# dimension, only day/month, so direct hour-level timing cannot be
# obtained from it and this codebase never fabricates it).
# Re-run `python -m youtube.uploader --authorize` once after enabling this
# to grant the additional yt-analytics.readonly scope to any channel whose
# refresh token predates it - see the SCOPES comment in youtube/uploader.py.
YOUTUBE_ANALYTICS_ENABLED=false
YOUTUBE_ANALYTICS_USE_PERFORMANCE_INFERENCE=true
YOUTUBE_ANALYTICS_CACHE_TTL_HOURS=24
YOUTUBE_ANALYTICS_LOOKBACK_DAYS=90
YOUTUBE_ANALYTICS_MIN_VIDEOS=5
YOUTUBE_ANALYTICS_TIMEZONE=Europe/Istanbul
YOUTUBE_ANALYTICS_MIN_SAMPLE_LOW=5
YOUTUBE_ANALYTICS_MIN_SAMPLE_MEDIUM=10
YOUTUBE_ANALYTICS_MIN_SAMPLE_HIGH=20

# --- Shorts Engine V1 (AI FOUND THIS) ---
# Purely additive/opt-in: when SHORTS_ENABLED=false (the library default),
# pipeline.py never runs a single Shorts production stage, no `shorts` DB
# row is ever created, and the Telegram approval sent for a produced Long
# is byte-for-byte the original single-video message - exactly as before
# this feature existed.
#
# When true: for every produced Long video, SHORTS_PER_LONG Shorts are
# additionally produced from the SAME research/script (no second research
# call, no separate Shorts topic selection - see youtube/shorts_planner.py).
# Each Short reuses the Long's own scene images when safe to center-crop to
# 9:16, or generates a dedicated vertical image only when necessary (see
# youtube/shorts_visual.py). If every Short passes its own QC
# (youtube/shorts_qc.py), ONE combined Telegram approval is sent for the
# Long + all Shorts together (thumbnails only - never a video file); a
# single APPROVE uploads and schedules all four pieces, a single REJECT
# rejects all four. If any Short fails QC, no package is sent as
# approve-ready - a plain failure notice is sent instead (see
# youtube/telegram_approval.py's send_new_package_approval()/
# send_shorts_production_failed_notice()).
SHORTS_ENABLED=false
SHORTS_PER_LONG=3
SHORTS_TIMEZONE=Europe/Istanbul
# Target vertical (9:16) render resolution for every Short - independent
# of VIDEO_WIDTH/VIDEO_HEIGHT above (the Long's own 16:9 resolution, never
# changed by this feature).
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
# Target narration length band per Short (spec: "~30-50 seconds, not
# forced exact"). This is the HARD QC GATE band: youtube/shorts_qc.py
# fails any Short whose real (ffprobe-measured) MP4 duration falls outside
# it - added by the 2026-09 duration hard-gate patch after a real 55.2s
# Short incorrectly passed QC under the old duration>0-only check.
SHORTS_TARGET_SECONDS_MIN=30
SHORTS_TARGET_SECONDS_MAX=50
# Preferred sweet spot WITHIN the hard band above (spec: "preferably
# 40-48 seconds") - the Shorts Planner's condensation prompt aims for this
# narrower range so a natural, non-truncated script lands comfortably
# inside the hard gate rather than right at its edge.
SHORTS_PREFERRED_SECONDS_MIN=40
SHORTS_PREFERRED_SECONDS_MAX=48
# Conservative real-narration-pace estimate (words/sec) used ONLY by the
# Shorts Planner's own word-budget math - deliberately separate from
# scene_planner.py's/tts.py's own 2.5 words/sec constants (those are
# unrelated scene-timing/mock-tone estimates and are not touched by this
# patch). A real production Short with 122 words of narration measured
# ~2.21 words/sec of actual TTS audio, noticeably slower than 2.5 - this
# lower default keeps the planner's word target realistic without ever
# mechanically truncating or padding the narration text itself.
SHORTS_WORDS_PER_SECOND=2.2
# Fixed daily publish slots per Short (recommended default cadence) - pure
# configuration, never hard-coded into business logic. Uses the existing
# Smart Publish Scheduler's own slot-computation helper
# (youtube.smart_publish._next_bootstrap_slot) with these hours instead of
# SMART_PUBLISH_DEFAULT_HOUR/MINUTE - Smart Publish/Analytics Timing
# themselves are completely unmodified by this feature.
SHORT_1_DEFAULT_HOUR=12
SHORT_1_DEFAULT_MINUTE=00
SHORT_2_DEFAULT_HOUR=16
SHORT_2_DEFAULT_MINUTE=00
SHORT_3_DEFAULT_HOUR=22
SHORT_3_DEFAULT_MINUTE=00
